      "columnIndex": 18,
      "columnMaxSize": 253,
      "columnName": "P&L Gross Type",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "if(\"Base Type P&L\" in ('Total Cost of Goods Sold','Total Operating Income'),'Total Gross Profit','')",
