    {
      "columnDesc": "",
      "columnId": "264324000001765037",
      "columnIndex": 9,
      "columnMaxSize": 253,
      "columnName": "Account Type Balance sheet",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "If(\"Account Type\" = 'Stock','Other asset',\"Account Type\")",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0
    },
    {
      "columnDesc": "",
      "columnId": "264324000001765038",
      "columnIndex": 10,
      "columnMaxSize": 253,
      "columnName": "Account Group",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "If(\"Account Type\" in ('Accounts Receivable','Bank','Cash','Other Current Asset','Stock') and \"Account Base Type\" = 'Asset','Total Current Assets',if(\"Account Base Type\" = 'Asset' and \"Account Type\" in ('Fixed Asset'),'Total Fixed Assets',if(\"Account Base Type\" = 'Liability','Total Current Liabilities',if(\"Account Base Type\" = 'Equities','Total Equities',if(\"Account Base Type\" in ('Income','Expense'),'Equites','')))))",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0
    },
    {
      "columnDesc": "",
      "columnId": "264324000001765039",
      "columnIndex": 11,
      "columnMaxSize": 253,
      "columnName": "Balance sheet base type",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "If(\"Account Base Type\" in ('Liability','Expense','Income'),'Total Liabilities & Equities',\"Account Base Type\")",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0
    },
    {
      "columnDesc": "",
      "columnId": "264324000001765040",
      "columnIndex": 12,
      "columnMaxSize": 253,
      "columnName": "Balance Sheet Account Type",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "If(\"Account Base Type\" in ('Income','Expense'),'',\"Account Type\")",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0
    },
    {
      "columnDesc": "",
      "columnId": "264324000001765041",
      "columnIndex": 13,
      "columnMaxSize": 253,
      "columnName": "Balance Sheet Account Name",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "If(\"Account Base Type\" in ('Income','Expense'),'',\"Account Name\")",
      "isHidden": false,
      "isNullable": true,
