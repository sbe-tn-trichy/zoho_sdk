      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "if(\"Base Type P&L\" in ('Total Operating Income','Total Cost of Goods Sold','Total Operating Expense'),'Total Operating Profit','Total Non Operating Income/Expense')",
