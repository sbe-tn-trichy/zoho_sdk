      "columnId": "264324000001765045",
      "columnIndex": 17,
      "columnMaxSize": 253,
      "columnName": "Base Type P&L",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "If(\"Account Base Type\" in ('Income'),'Total Operating Income',if(\"Account Type\" in ('Cost Of Goods Sold'),'Total Cost of Goods Sold',if(\"Account Base Type\" in ('Expense') and \"Account Type\" not in ('Cost Of Goods Sold'),'Total Operating Expense',\"Account Type\")))",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0
    },
    {
