      "columnName": "Color",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "CASE  WHEN upper(`Item Name`) LIKE upper('%Red%')  THEN 'Red' WHEN upper(`Item Name`) LIKE upper('%Blue%')  THEN 'Blue' WHEN upper(`Item Name`) LIKE upper('%Amber%')  THEN 'Amber' WHEN upper(`Item Name`) LIKE upper('%6500K%')  THEN 'CW' WHEN upper(`Item Name`) LIKE upper('%3000K%')  THEN 'WW' WHEN upper(`Item Name`) LIKE upper('%Pink%')  THEN 'Pink' WHEN upper(`Item Name`) LIKE upper('%Green%')  THEN 'Green' ELSE 'NA' END",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0
    },
