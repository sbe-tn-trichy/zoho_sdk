      "dataTypeId": 6,
      "dataTypeName": "Decimal Number",
      "decimalPlaces": -1,
      "decimalSeparator": ".",
      "defaultValue": "",
      "formulaDisplayName": "TO_DECIMAL(IF(\"Discount Amount (FCY)\" > 0, round(\"Discount Amount (FCY)\"/\"Sub Total (FCY)\", 3),\"Discount (%)\"*0.01), 38,4)",
      "isHidden": false,
