    {
      "columnDesc": "",
      "columnId": "264324000001787616",
      "columnIndex": 60,
      "columnMaxSize": 253,
      "columnName": "Aging Days",
      "dataType": "PLAIN",
      "dataTypeId": 1,
      "dataTypeName": "Plain Text",
      "defaultValue": "",
      "formulaDisplayName": "case when \"days\" <30 then '1-30 days'\nwhen \"days\" <45 then '30-45 days'\nwhen \"days\" <60 then '45-60 days'\nwhen \"days\" <75 then '60-75 days'\nelse '>75 days'\nend",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0
    },
    {
