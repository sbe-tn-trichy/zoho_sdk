      "dataType": "NUMBER",
      "dataTypeId": 4,
      "dataTypeName": "Number",
      "decimalPlaces": -1,
      "decimalSeparator": ".",
      "defaultValue": "",
      "formulaDisplayName": "IF(\"Balance (BCY)\"=0, date_diff(\"Last Payment Date\",\"Invoice Date\"), null)",
      "isHidden": false,
      "isNullable": true,
      "pkColumnName": "",
      "pkTableName": "",
      "sortedIndex": -1,
      "sortedOrder": 0,
      "thousandSeparator": ""
    },
    {
